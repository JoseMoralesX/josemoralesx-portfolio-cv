.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Secrets / env files
.env
.env.*
!.env.example
secrets/
.secrets/

# ML artifacts
**/model.joblib
**/*.joblib
**/*.pkl

# Terraform (often contains credentials/state)
**/.terraform/
**/.terraform.lock.hcl
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
**/*.tfvars.json
**/crash.log

# Node / web (in case you add a frontend later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
